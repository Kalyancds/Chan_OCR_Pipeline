        "block_type": "SectionHeader",
        "html": "<h2>Nemluvio (Nemolizumab) — Fachinformation</h2>",
        "markdown": "## Nemluvio (Nemolizumab) — Fachinformation",
        "bbox": [180, 210, 2360, 320],
